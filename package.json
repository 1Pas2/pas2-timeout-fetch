{
  "name": "@1pas2/timeout-fetch",
  "version": "0.1.0",
  "description": "Bound a fetch request and combine caller cancellation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "author": "1Pas2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1Pas2/pas2-timeout-fetch.git"
  },
  "bugs": {
    "url": "https://github.com/1Pas2/pas2-timeout-fetch/issues"
  },
  "homepage": "https://github.com/1Pas2/pas2-timeout-fetch#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check:examples": "tsc -p tsconfig.examples.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.1"
  }
}
